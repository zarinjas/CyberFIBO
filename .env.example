# CyberFIBO — contoh konfigurasi
# Salin ke /opt/trading/.env dan isi nilai sebenar, kemudian: chmod 600

# Bot Telegram untuk kawalan (dari @BotFather)
TG_TOKEN=123456789:REPLACE_WITH_YOUR_BOTFATHER_TOKEN

# Chat id yang menerima notifikasi (id peribadi kau)
TG_CHAT=000000000

# Siapa dibenarkan memberi arahan (senarai dipisah koma)
TG_ALLOWED=000000000

# Di mana state hidup
#   Linux   : /opt/trading
#   Windows : Z:/opt/trading  (atau C:/trading)
TRADER_ROOT=/opt/trading
