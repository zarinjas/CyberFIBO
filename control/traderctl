def cmd_bot():
    e = env()
    tok, chat = e.get("TG_TOKEN"), e.get("TG_CHAT")
    if not tok or not chat:
        sys.exit("TG_TOKEN / TG_CHAT missing from %s" % ENVF)
    allowed = {int(x) for x in e.get("TG_ALLOWED", chat).split(",") if x.strip()}
    print("trader bot up (chat=%s, allowed=%s)" % (chat, sorted(allowed)))
    send(tok, chat, "🟢 <b>CyberFibo control</b> sedia.\nGuna butang di bawah.", BUTTONS)
    off = 0
    while True:
        try:
            upd = api(tok, "getUpdates", offset=off, timeout=50)
        except Exception as ex:
            print("poll error: %s" % ex)
            time.sleep(5)
            continue
        for u in upd.get("result", []):
            off = u["update_id"] + 1
            uid = (u.get("message") or u.get("callback_query", {}).get("message") or {}).get("chat", {}).get("id")
            if uid not in allowed:
                continue
            cq = u.get("callback_query")
            m = u.get("message", {}) or {}
            raw_txt = (m.get("text") or "").strip()
            txt = raw_txt.lower()
            verb = cq["data"] if cq else txt.lstrip("/").split()[0]

            # ---- /strategy [fibo|chain|ema74] ---------------------------
            if not cq and txt.startswith("/strategy"):
                parts = raw_txt.split()
                if len(parts) == 1:
                    send(tok, uid, "<pre>%s</pre>" % run_ctl("strategy").replace("<", "&lt;"),
                         BUTTONS)
                else:
                    res = strategy_switch(parts[1])
                    send(tok, uid, ("\u2705 <b>Strategy Changed</b>\n\nCurrent Strategy:\n<b>%s</b>"
                                    % STRAT.active()) if res.startswith("ditukar")
                         else ("\u26d4 %s" % res), BUTTONS)
                continue
            # -------------------------------------------------------------
            # ---- /lot [peratus] -----------------------------------------
            if not cq and txt.startswith(("/lot", "/risk")):
                parts = raw_txt.split()
                if len(parts) == 1:
                    send(tok, uid, "<pre>%s</pre>" % run_ctl("status").replace("<", "&lt;"),
                         RISK_BUTTONS)
                else:
                    set_risk(tok, uid, parts[1])
                continue
            # -------------------------------------------------------------
            # ---- /login <server> <login> <password> ----------------------
            if not cq and txt.startswith("/login"):
                parts = raw_txt.split()
                mid = m.get("message_id")
                if len(parts) < 4:
                    send(tok, uid, "Format: <code>/login SERVER LOGIN PASSWORD</code>\n"
                                   "contoh: /login TradingProInternational-Demo 5008941 rahsia",
                         BUTTONS)
                    continue
                srv, lgn, pw = parts[1], parts[2], parts[3]
                tg_del(tok, uid, mid)                      # scrub it immediately
                send(tok, uid, "⏳ cuba login ke <b>%s</b> sebagai %s ..." % (srv, lgn))
                res = mt5_login(srv, lgn, pw)
                del pw                                     # drop it here too
                if res.get("login_ok"):
                    save_broker(srv, lgn, res.get("account"))
                    a = res.get("account") or {}
                    send(tok, uid, "✅ <b>LOGIN OK</b>\nserver  : %s\nlogin   : %s\n"
                                   "balance : %s %s\nleverage: 1:%s"
                         % (srv, lgn, a.get("balance"), a.get("currency"), a.get("leverage")),
                         BUTTONS)
                else:
                    send(tok, uid, "❌ <b>LOGIN GAGAL</b>\n%s" % str(res.get("error"))[:300],
                         BUTTONS)
                continue
            # -------------------------------------------------------------
            if cq:
                try:
                    api(tok, "answerCallbackQuery", callback_query_id=cq["id"])
                except Exception:
                    pass
            if verb in ("brokers",):
                send(tok, uid, "<pre>%s</pre>" % run_ctl("brokers"), BUTTONS)
            elif verb == "switch":
                b = load_brokers()
                if not b:
                    send(tok, uid, "tiada broker tersimpan. Guna 🔐 LOGIN BROKER dulu.", BUTTONS)
                else:
                    kb = [[_b("🔄 %s (%s)" % (k, v.get("login")), "use:" + k)]
                          for k, v in list(b.items())[:8]]
                    send(tok, uid, "Pilih broker:", kb)
            elif verb.startswith("use:"):
                key = verb[4:]
                b = load_brokers()
                v = b.get(key)
                if not v:
                    send(tok, uid, "broker tidak dijumpai: %s" % key, BUTTONS)
                else:
                    send(tok, uid, "⏳ cuba tukar ke <b>%s</b> (login %s) tanpa password "
                                   "- MT5 guna kredensial tersimpan ..." % (key, v.get("login")))
                    res = mt5_login(key, v.get("login"), "")
                    send(tok, uid, ("✅ ditukar ke %s" % key) if res.get("login_ok")
                         else ("❌ perlu password semula ✗ — hantar "
                               "<code>/login %s %s PASSWORD</code>" % (key, v.get("login"))),
                         BUTTONS)
            elif verb == "tf":
                send(tok, uid, "⏱ <b>Pilih timeframe fibo</b>\n"
                               "Bot membaca permintaan ini pada poll berikutnya "
                               "(30s atau kurang) tanpa restart. Trend filter ikut sama.",
                     TF_BUTTONS)
            elif verb.startswith("tf:"):
                tf = verb[3:].upper()
                if tf not in ("M5", "M15", "H1", "H4"):
                    send(tok, uid, "timeframe tidak sah: %s" % tf, BUTTONS)
                else:
                    write_request(only=True, tf=tf)
                    send(tok, uid, "✅ Fibonacci ditukar ke <b>%s</b>\n"
                                   "Trend filter juga %s.\n"
                                   "Bot akan guna ini pada kitaran berikutnya (30s atau kurang)."
                                   % (tf, tf), BUTTONS)
            elif verb == "strategy":
                if not STRAT:
                    send(tok, uid, "registry tidak dijumpai", BUTTONS)
                else:
                    kb = [[_b("%s %s" % (STRAT.ICON.get(STRAT.info(sid).get("status"), ""), sid),
                              "strategy:" + sid)] for sid in STRAT.REGISTRY]
                    kb.append([_b("\U0001f519 kembali", "menu")])
                    send(tok, uid, "<pre>%s</pre>"
                         % run_ctl("strategy").replace("<", "&lt;"), kb)
            elif verb.startswith("strategy:"):
                sid = verb.split(":", 1)[1]
                res = strategy_switch(sid)
                send(tok, uid, ("\u2705 <b>Strategy Changed</b>\n\nCurrent Strategy:\n<b>%s</b>"
                                % STRAT.active()) if res.startswith("ditukar")
                     else ("\u26d4 %s" % res), BUTTONS)
            elif verb == "risk":
                send(tok, uid, "💰 <b>Saiz lot (risiko %)</b>\n"
                               "Lot dikira dari jarak stop dan baki akaun:\n"
                               "  risiko naik  -> lot BESAR\n"
                               "  risiko turun -> lot KECIL\n"
                               "Bot guna ini pada kitaran berikutnya (30s atau kurang).",
                     RISK_BUTTONS)
            elif verb.startswith("risk:"):
                set_risk(tok, uid, verb.split(":", 1)[1])
            elif verb == "menu":
                send(tok, uid, "Menu:", BUTTONS)
            elif verb in ("status", "next", "trades", "why"):
                send(tok, uid, "<pre>%s</pre>" % run_ctl(verb).replace("<", "&lt;"), BUTTONS)
            elif verb == "pause":
                write_control(paused=True)
                send(tok, uid, "⏸ <b>PAUSE</b> - tiada leg baharu akan dibuka.\n"
                               "Posisi sedia ada kekal (SL/TP server-side).", BUTTONS)
            elif verb == "resume":
                write_control(paused=False)
                send(tok, uid, "▶️ <b>RESUME</b> - bot boleh masuk setup semula.", BUTTONS)
            elif verb == "skip":
                write_control(skip=True)
                send(tok, uid, "⏭ <b>SKIP</b> - group semasa ditandakan habis, cari yang seterusnya.", BUTTONS)
            elif verb == "closeall":
                write_control(close_all=True)
                send(tok, uid, "⚠️ <b>CLOSE ALL</b> dihantar - bot akan tutup semua leg miliknya.", BUTTONS)
            elif verb in ("start", "menu", "help"):
                send(tok, uid, "🟢 <b>CyberFibo control</b>\nButang di bawah, atau taip "
                               "status / next / trades / why / pause / resume / skip.", BUTTONS)
            else:
                send(tok, uid, "arahan tidak dikenali: <code>%s</code>" % verb, BUTTONS)


def cmd_tgcheck():
    """Diagnose the Telegram side: which bot, and whether the user has opened it."""
    e = env()
    tok, chat = e.get("TG_TOKEN"), e.get("TG_CHAT")
    if not tok or not chat:
        sys.exit("TG_TOKEN / TG_CHAT missing from %s" % ENVF)
    try:
        me = api(tok, "getMe")["result"]
        print("bot     : @%s (id %s)" % (me.get("username"), me.get("id")))
    except Exception as ex:
        print("bot     : TIDAK BOLEH hubungi Telegram: %s" % ex)
        return
    print("chat id : %s" % chat)
    try:
        r = api(tok, "getChat", chat_id=chat)["result"]
        nm = r.get("first_name") or r.get("title") or "?"
        print("chat    : OK - %s" % nm)
        print("VERDICT : bot BOLEH hantar mesej kepada kau")
    except urllib.error.HTTPError as ex:
        print("chat    : HTTP %d %s" % (ex.code, ex.read().decode("utf-8", "replace")[:200]))
        print("VERDICT : kau BELUM tekan /start pada @%s" % me.get("username"))
        print("          buka https://t.me/%s dan tekan START" % me.get("username"))
    except Exception as ex:
        print("chat    : ERR %s" % ex)


def cmd_notify():
    e = env()
    tok, chat = e.get("TG_TOKEN"), e.get("TG_CHAT")
    if not tok or not chat:
        sys.exit("TG_TOKEN / TG_CHAT missing")
    print("notifier up, tailing %s" % EVENTS)
    EVENTS.touch()
    pos = EVENTS.stat().st_size
    while True:
        time.sleep(3)
        try:
            size = EVENTS.stat().st_size
            if size < pos:
                pos = 0
            if size == pos:
                continue
            with EVENTS.open() as f:
                f.seek(pos)
                for line in f:
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        ev = json.loads(line)
                    except Exception:
                        continue
                    kind = ev.get("kind", "info")
                    icon = {"entry": "🟢 MASUK", "exit": "🔴 KELUAR", "be": "🛡 LINDUNG", "skip": "⏭ SKIP",
                            "error": "⚠️ RALAT", "sim": "🧪 SIM",
                            "be": "🛡 LINDUNG"}.get(kind, "ℹ️")
                    sid = ev.get("strategy_id") or "?"
                    send(tok, chat, "<b>%s · %s</b>\n<code>%s</code>"
                         % (icon, sid, str(ev.get("text", ""))[:900]))
                pos = f.tell()
        except Exception as ex:
            print("notify error: %s" % ex)


