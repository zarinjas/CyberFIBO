def strategy_switch(word):
    """Tukar strategy aktif. Menolak jika posisi terbuka (elak campur)."""
    if not STRAT:
        return "registry tidak dijumpai"
    sid = STRAT.resolve(word)
    if not sid:
        return ("strategy tidak dikenali: %s\n  guna: fibo | chain | ema74" % word)
    cur = STRAT.active()
    if sid == cur:
        return "sudah aktif: %s (%s)" % (sid, STRAT.info(sid).get("status"))
    n = open_positions_count()
    if n:
        return ("DITOLAK - %d posisi masih terbuka.\n"
                "  Tutup dahulu (butang CLOSE ALL) supaya posisi tidak bercampur "
                "antara strategy." % n)
    d = STRAT.info(sid)
    if d.get("status") != STRAT.ACTIVE:
        # dibenarkan menukar KE strategy bukan-aktif? Tidak - itu akan menipu
        # pengguna kerana bot akan menolak untuk berjalan.
        return ("DITOLAK - %s berstatus %s.\n  %s\n"
                "  Strategy bukan-ACTIVE tidak boleh membuka trade hidup."
                % (sid, d.get("status"), d.get("note", "")))
    STRAT.set_active(sid)
    return "ditukar ke %s" % sid


