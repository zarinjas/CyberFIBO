def api(tok, method, **params):
    url = "https://api.telegram.org/bot%s/%s" % (tok, method)
    data = urllib.parse.urlencode(params).encode() if params else None
    req = urllib.request.Request(url, data=data)
    with urllib.request.urlopen(req, timeout=60) as r:
        return json.load(r)


def send(tok, chat, text, keyboard=None):
    p = {"chat_id": chat, "text": text, "parse_mode": "HTML"}
    if keyboard:
        p["reply_markup"] = json.dumps({"inline_keyboard": keyboard})
    try:
        api(tok, "sendMessage", **p)
        return True
    except urllib.error.HTTPError as e:
        body = e.read().decode("utf-8", "replace")[:300]
        print("send failed: HTTP %d %s" % (e.code, body))
        return False
    except Exception as e:
        print("send failed: %s" % e)
        return False


def _b(text, data):
    return {"text": text, "callback_data": data}


BUTTONS = [
    [_b("🔐 LOGIN BROKER", "login"), _b("🔄 SWITCH BROKER", "switch")],
    [_b("📊 STATUS", "status"), _b("🎯 NEXT SETUP", "next")],
    [_b("📈 OPEN TRADES", "trades"), _b("❓ WHY NO TRADE", "why")],
    [_b("⏸ PAUSE", "pause"), _b("▶️ RESUME", "resume")],
    [_b("⏭ SKIP GROUP", "skip")],
]


def run_ctl(arg):
    """run this same script's subcommand and return its stdout"""
    r = subprocess.run([sys.executable, os.path.abspath(__file__), arg],
                       capture_output=True, text=True, timeout=30)
    return (r.stdout or r.stderr).strip()


def tg_del(tok, chat, msg_id):
    """Delete a message (used to scrub a password out of the chat)."""
    try:
        api(tok, "deleteMessage", chat_id=chat, message_id=msg_id)
        return True
    except Exception as e:
        print("delete failed: %s" % e)
        return False


def load_brokers():
    try:
        if BROKERS.exists():
            return json.loads(BROKERS.read_text())
    except Exception:
        pass
    return {}


def save_broker(server, login, extra=None):
    b = load_brokers()
    b[server] = {"server": server, "login": str(login), "when": int(time.time())}
    if extra:
        b[server].update(extra)
    BROKERS.write_text(json.dumps(b, indent=2))
    return b


def mt5_login(server, login, pw):
    """Hand the credentials to the Wine python on STDIN - argv stays clean."""
    if not LOGIN_SH.exists():
        return {"login_ok": False, "error": "mt5_login.sh belum dipasang"}
    r = subprocess.run([str(LOGIN_SH)], input="%s\n%s\n%s\n" % (server, login, pw),
                       capture_output=True, text=True, timeout=180)
    out = (r.stdout or "").strip().splitlines()
    for line in out:
        if line.startswith("{"):
            try:
                return json.loads(line)
            except Exception:
                pass
    return {"login_ok": False, "error": (r.stdout or r.stderr or "tiada output")[:300]}


