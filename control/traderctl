def write_request(only: bool = False, **kw):
    """Tulis state/request.json untuk dibaca scalper pada poll berikutnya.

    `only=True` menggantikan fail sepenuhnya (permintaan ini sahaja), supaya
    permintaan lama yang belum dibaca tidak bercampur dengan yang baharu.
    """
    REQ = ROOT / "state" / "request.json"
    REQ.parent.mkdir(parents=True, exist_ok=True)
    d = {} if only else (json.loads(REQ.read_text()) if REQ.exists() else {})
    d.update(kw)
    REQ.write_text(json.dumps(d))
    return True


def set_risk(tok, uid, v):
    """Tukar risiko % -> scalper kira semula lot. Lot besar bila % naik."""
    try:
        r = float(v)
    except (TypeError, ValueError):
        r = 0.0
    if not (0 < r <= 50):
        send(tok, uid, "⛔ risiko tidak sah: %s (guna 0.5 - 50)" % v, BUTTONS)
        return
    write_request(only=True, risk_pct=r)
    send(tok, uid, "✅ <b>Risiko ditukar ke %g%%</b>\n"
                   "Lot dikira dari jarak stop + baki akaun.\n"
                   "Bot guna ini pada kitaran berikutnya (30s atau kurang)." % r,
         BUTTONS)


def run_ctl(arg):
    """run this same script's subcommand and return its stdout"""
    r = subprocess.run([sys.executable, os.path.abspath(__file__), arg],
                       capture_output=True, text=True, timeout=30)
    return (r.stdout or r.stderr).strip()


def tg_del(tok, chat, msg_id):
    """Delete a message (used to scrub a password out of the chat)."""
    try:
        api(tok, "deleteMessage", chat_id=chat, message_id=msg_id)
        return True
    except Exception as e:
        print("delete failed: %s" % e)
        return False


def load_brokers():
    try:
        if BROKERS.exists():
            return json.loads(BROKERS.read_text())
    except Exception:
        pass
    return {}


def save_broker(server, login, extra=None):
    b = load_brokers()
    b[server] = {"server": server, "login": str(login), "when": int(time.time())}
    if extra:
        b[server].update(extra)
    BROKERS.write_text(json.dumps(b, indent=2))
    return b


def mt5_login(server, login, pw):
    """Hand the credentials to the Wine python on STDIN - argv stays clean."""
    if not LOGIN_SH.exists():
        return {"login_ok": False, "error": "mt5_login.sh belum dipasang"}
    r = subprocess.run([str(LOGIN_SH)], input="%s\n%s\n%s\n" % (server, login, pw),
                       capture_output=True, text=True, timeout=180)
    out = (r.stdout or "").strip().splitlines()
    for line in out:
        if line.startswith("{"):
            try:
                return json.loads(line)
            except Exception:
                pass
    return {"login_ok": False, "error": (r.stdout or r.stderr or "tiada output")[:300]}


