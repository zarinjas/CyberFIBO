#!/usr/bin/env python3
"""traderctl - single source of truth for the MT5 scalper control plane.

One file, stdlib only (python3.14 has no pip here). Subcommands:

    traderctl status      full picture: account, arms, open trades
    traderctl next        what the bots are waiting for right now
    traderctl trades      open positions only
    traderctl why         why no trade - per-arm last decision + reason
    traderctl pause       stop opening new legs (control.json paused=true)
    traderctl resume      allow entries again
    traderctl skip        mark the current group spent, hunt the next one
    traderctl closeall    flatten every leg the bots own
    traderctl sim         write a synthetic state so the UI can be tested
    traderctl bot         run the Telegram button bot (long poll)
    traderctl notify      tail events.jsonl -> Telegram

STATE CONTRACT (what the trading bot must write - see README in this dir):
    state/arms.json    account + per-arm status + open positions
    state/control.json {"paused":bool,"skip":bool,"close_all":bool}
    events.jsonl       one json per line: {"ts":..,"kind":"entry",
                       "text":"..."} -> pushed to Telegram by `notify`
"""
import json
import os
import pathlib
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

# Strategi: registry tinggal dalam bot/ (satu tempat untuk semua bot).
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent / "bot"))
try:
    import strategies as STRAT
except Exception:
    STRAT = None

# Windows Server CN ships with codepage GBK, so printing the button glyphs
# (arrows, pause bars, status dots) raises UnicodeEncodeError and the whole
# command dies. Force UTF-8 on the streams instead of stripping the glyphs:
# the messages are the product here.
for _s in (sys.stdout, sys.stderr):
    try:
        _s.reconfigure(encoding="utf-8", errors="replace")
    except Exception:
        pass

ROOT = pathlib.Path(os.environ.get("TRADER_ROOT", "/opt/trading"))
STATE = ROOT / "state"
ARMS = STATE / "arms.json"
CONTROL = STATE / "control.json"
EVENTS = ROOT / "events.jsonl"
ENVF = ROOT / ".env"
BROKERS = STATE / "brokers.json"
LOGIN_SH = ROOT / "bin" / "mt5_login.sh"


def env():
    d = {}
    if ENVF.exists():
        for line in ENVF.read_text().splitlines():
            if "=" in line and not line.strip().startswith("#"):
                k, v = line.split("=", 1)
                d[k.strip()] = v.strip()
    return d


def write_control(**kw):
    cur = {}
    if CONTROL.exists():
        try:
            cur = json.loads(CONTROL.read_text())
        except Exception:
            cur = {}
    cur.update(kw)
    cur["updated"] = int(time.time())
    CONTROL.parent.mkdir(parents=True, exist_ok=True)
    CONTROL.write_text(json.dumps(cur, indent=2))
    return cur


def load():
    if not ARMS.exists():
        return None
    try:
        return json.loads(ARMS.read_text())
    except Exception:
        return None


def fmt_money(x):
    return ("%+.2f" % x) if isinstance(x, (int, float)) else str(x)


def acct_line(d):
    """Satu baris identiti akaun, atau amaran kalau state tiruan."""
    a = d.get("account") or {}
    if d.get("synthetic"):
        return ("  ⚠️  DATA TIRUAN - BUKAN AKAUN SEBENAR\n"
                "  akaun    : (tiada - MT5 belum disambung)")
    if not a.get("login"):
        return "  akaun    : (belum dilaporkan oleh bot)"
    kind = {True: "DEMO", False: "LIVE"}.get(a.get("demo"), "?")
    return ("  akaun    : %s @ %s\n"
            "  nama     : %s   [%s]  leverage 1:%s"
            % (a.get("login"), a.get("server") or "?", a.get("name") or "-",
               kind, a.get("leverage") or "?"))


