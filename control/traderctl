def cmd_notify():
    e = env()
    tok, chat = e.get("TG_TOKEN"), e.get("TG_CHAT")
    if not tok or not chat:
        sys.exit("TG_TOKEN / TG_CHAT missing")
    print("notifier up, tailing %s" % EVENTS)
    EVENTS.touch()
    pos = EVENTS.stat().st_size
    while True:
        time.sleep(3)
        try:
            size = EVENTS.stat().st_size
            if size < pos:
                pos = 0
            if size == pos:
                continue
            with EVENTS.open() as f:
                f.seek(pos)
                for line in f:
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        ev = json.loads(line)
                    except Exception:
                        continue
                    kind = ev.get("kind", "info")
                    icon = {"entry": "🟢 MASUK", "exit": "🔴 KELUAR", "skip": "⏭ SKIP",
                            "error": "⚠️ RALAT", "sim": "🧪 SIM"}.get(kind, "ℹ️")
                    send(tok, chat, "<b>%s</b>\n<code>%s</code>"
                         % (icon, str(ev.get("text", ""))[:900]))
                pos = f.tell()
        except Exception as ex:
            print("notify error: %s" % ex)


CMDS = {"status": cmd_status, "next": cmd_next, "trades": cmd_trades, "why": cmd_why,
        "pause": lambda: print(write_control(paused=True) and "⏸ paused"),
        "resume": lambda: print(write_control(paused=False) and "▶️ resumed"),
        "skip": lambda: print(write_control(skip=True) and "⏭ skip armed"),
        "closeall": lambda: print(write_control(close_all=True) and "⚠️ close_all armed"),
        "brokers": cmd_brokers, "sim": cmd_sim, "bot": cmd_bot, "notify": cmd_notify, "tgcheck": cmd_tgcheck}

if __name__ == "__main__":
    a = sys.argv[1] if len(sys.argv) > 1 else "status"
    if a not in CMDS:
        sys.exit("usage: traderctl {%s}" % "|".join(CMDS))
    CMDS[a]()
